<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.room">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#dbe5dd" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.room:pointerover"><Setter Property="Background" Value="#ffffff17" /></Style>
  <Style Selector="Button.room:pressed"><Setter Property="Background" Value="#ffffff28" /></Style>
  <Style Selector="Button.room:focus-visible"><Setter Property="BorderBrush" Value="#d9ef81" /></Style>
  <Style Selector="Button.room:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="Button.catalog"><Setter Property="Foreground" Value="#172e2b" /><Setter Property="Padding" Value="9" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.catalog:pointerover"><Setter Property="Background" Value="#e9ece2" /></Style>
  <Style Selector="Button.catalog.selected"><Setter Property="Background" Value="#e6eade" /><Setter Property="BorderBrush" Value="#d5ddcb" /></Style>
  <Style Selector="Button.outline"><Setter Property="Foreground" Value="#526b5c" /><Setter Property="BorderBrush" Value="#cbd4c7" /><Setter Property="Padding" Value="10,7" /></Style>
  <Style Selector="Button.outline:pointerover"><Setter Property="Background" Value="#e4e8dc" /></Style>
  <Style Selector="ComboBox.room"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#dbe5dd" /><Setter Property="BorderBrush" Value="#ffffff20" /><Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,3" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style Selector="ComboBox.room /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="#dbe5dd" /></Style>
  <Style Selector="ComboBox.room /template/ Border#HighlightBackground"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#ffffff20" /></Style>
  <Style Selector="Slider.room">
    <Setter Property="Foreground" Value="#d9ef81" />
    <Setter Property="Background" Value="#718576" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Slider.room /template/ Thumb">
    <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
    <Setter Property="Background" Value="#d9ef81" />
  </Style>
</Styles>
