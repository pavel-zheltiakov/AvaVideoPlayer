<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>WinExe</OutputType>
    <UseOwnEngine Condition="'$(UseOwnEngine)' == ''">true</UseOwnEngine>
    <DefineConstants Condition="'$(UseOwnEngine)' == 'true'">$(DefineConstants);AVAVIDEO_OWN_ENGINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AvaVideoPlayer.Sample/AvaVideoPlayer.Sample.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  <Content Include="../AvaVideoPlayer.Demo.Browser/media/*-360.mp4;../AvaVideoPlayer.Demo.Browser/media/*-360.mov;../AvaVideoPlayer.Demo.Browser/media/*-360.webm" Link="media/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><PackageReference Include="AvaVideoPlayer" Version="0.1.0-preview.2" /></ItemGroup>
</Project>